<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StudentOrganiser.Pages.Tasks"
             Title="Tasks">

	<ScrollView>
		<VerticalStackLayout 
            Padding="25"
            Spacing="20">

			<!-- Nagłówek -->
			<Label 
                Text="Task Manager"
                FontSize="28"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

			<!-- Sekcja dodawania zadania -->
			<Frame 
                Padding="15"
                CornerRadius="12"
                HasShadow="True">

				<VerticalStackLayout Spacing="12">

					<Entry 
                        x:Name="taskName"
                        Placeholder="Enter task name"
                        ClearButtonVisibility="WhileEditing"/>

					<Button 
                        Text="Add Task"
                        Clicked="AddTaskClick"
                        CornerRadius="8"/>

				</VerticalStackLayout>
			</Frame>

			<!-- Sekcja wyświetlania zadań -->
			<Frame 
                Padding="15"
                CornerRadius="12"
                HasShadow="True">

				<VerticalStackLayout Spacing="12">

					<Button 
                        Text="Show Tasks"
                        Clicked="ShowAllTasksClicked"
                        CornerRadius="8"/>

					<Label 
                        x:Name="ShowTasks"
                        Text="No tasks yet..."
                        FontSize="16"/>

				</VerticalStackLayout>
			</Frame>

		</VerticalStackLayout>
	</ScrollView>

</ContentPage>