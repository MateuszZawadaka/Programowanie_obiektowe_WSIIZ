<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GraphAlgorithms.MainPage">

	<ScrollView>
		<VerticalStackLayout
            Padding="30,0"
            Spacing="25">
			<Image
                Source="wsiz_logo.png"
                HeightRequest="185"
                Aspect="AspectFit"
                SemanticProperties.Description="Logo uczelni" />


			<Label
                Text="Algorytmy grafowe"
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level1" />
			<Label
                Text="Aplikacja edukacyjna prezentująca działanie algorytmów grafowych z wykorzystaniem graficznego interfejsu użytkownika w technologii .NET MAUI.&#10;&#10;
				      Projekt umożliwia wizualizację krok po kroku algorytmów takich jak BFS (przeszukiwanie wszerz), DFS (przeszukiwanie w głąb) oraz algorytmu komiwojażera, co pozwala na łatwiejsze zrozumienie zasad ich działania."
                Style="{StaticResource SubHeadline}"
                SemanticProperties.HeadingLevel="Level2"
                SemanticProperties.Description="Opis projektu algorytmy grafowe w .NET MAUI" />

			<Label Text="Autor: Mateusz Zawadka"
       FontSize="14"
       TextColor="Gray"
       HorizontalOptions="Center" />

		</VerticalStackLayout>
	</ScrollView>

</ContentPage>
